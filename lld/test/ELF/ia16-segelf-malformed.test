# REQUIRES: x86
# RUN: yaml2obj --docnum=1 %s -o %t.seg16.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.seg16.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SEG16
# RUN: yaml2obj --docnum=2 %s -o %t.huge8.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.huge8.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=HUGE8
# RUN: yaml2obj --docnum=3 %s -o %t.sub16.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.sub16.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUB16
# RUN: yaml2obj --docnum=12 %s -o %t.sub32.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.sub32.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUB32
# RUN: yaml2obj --docnum=8 %s -o %t.seg16-nonalloc.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.seg16-nonalloc.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SEG16-NONALLOC
# RUN: yaml2obj --docnum=9 %s -o %t.huge8-nonalloc.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.huge8-nonalloc.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=HUGE8-NONALLOC
# RUN: yaml2obj --docnum=10 %s -o %t.sub16-nonalloc.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.sub16-nonalloc.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUB16-NONALLOC
# RUN: yaml2obj --docnum=11 %s -o %t.sub32-nonalloc.o
# RUN: not ld.lld -m elf_i386 --entry=0 %t.sub32-nonalloc.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SUB32-NONALLOC
# RUN: not ld.lld -m elf_i386 -r %t.seg16.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=SEG16
# RUN: yaml2obj --docnum=4 %s -o %t.gc.o
# RUN: not ld.lld -m elf_i386 --gc-sections --entry=entry %t.gc.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=GC
# RUN: yaml2obj --docnum=5 %s -o %t.eh-frame.o
# RUN: not ld.lld -m elf_i386 %t.eh-frame.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=EH
# RUN: yaml2obj --docnum=6 %s -o %t.partial.o
# RUN: not ld.lld -m elf_i386 %t.partial.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=PARTIAL
# RUN: yaml2obj --docnum=7 %s -o %t.large-offset.o
# RUN: not ld.lld -m elf_i386 %t.large-offset.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=LARGE

# SEG16: error: {{.*}}:(.data+0x2): relocation R_386_SEG16 requires a 2-byte field, but the section has 0 bytes available
# HUGE8: error: {{.*}}:(.data+0x1): relocation R_386_HUGE8 requires a 1-byte field, but the section has 0 bytes available
# SUB16: error: {{.*}}:(.data+0x2): relocation R_386_SUB16 requires a 2-byte field, but the section has 0 bytes available
# SUB32: error: {{.*}}:(.data+0x4): relocation R_386_SUB32 requires a 4-byte field, but the section has 0 bytes available
# SEG16-NONALLOC: error: {{.*}}:(.debug_data+0x2): relocation R_386_SEG16 requires a 2-byte field, but the section has 0 bytes available
# HUGE8-NONALLOC: error: {{.*}}:(.debug_data+0x1): relocation R_386_HUGE8 requires a 1-byte field, but the section has 0 bytes available
# SUB16-NONALLOC: error: {{.*}}:(.debug_data+0x2): relocation R_386_SUB16 requires a 2-byte field, but the section has 0 bytes available
# SUB32-NONALLOC: error: {{.*}}:(.debug_data+0x4): relocation R_386_SUB32 requires a 4-byte field, but the section has 0 bytes available
# GC: error: {{.*}}:(.text+0x2): relocation R_386_SEG16 requires a 2-byte field, but the section has 0 bytes available
# EH: error: {{.*}}:(.eh_frame+0x30): relocation R_386_SUB32 requires a 4-byte field, but the section has 0 bytes available
# PARTIAL: error: {{.*}}:(.data+0x1): relocation R_386_SUB16 requires a 2-byte field, but the section has 1 bytes available
# LARGE: error: {{.*}}:(.data+0xffffffff): relocation R_386_HUGE8 requires a 1-byte field, but the section has 0 bytes available

--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2LSB
  Type: ET_REL
  Machine: EM_386
Sections:
  - Name: .data
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    Content: "0000"
  - Name: .rel.data
    Type: SHT_REL
    Link: .symtab
    Info: .data
    Relocations:
      - Offset: 2
        Symbol: target
        Type: R_386_SEG16
Symbols:
  - Name: target
    Index: SHN_ABS
    Value: 0x12345

